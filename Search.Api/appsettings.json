{
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "ProductIndex": "products"
  },

  "ProductSearch": {
    "NameBoost": 1,
    "DescriptionBoost": 1,
    "CategoryBoost": 1
  },

  "Redis": {
    "ConnectionString": "localhost:6379",
    "CacheExpirationMinutes": 5
  },

  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}